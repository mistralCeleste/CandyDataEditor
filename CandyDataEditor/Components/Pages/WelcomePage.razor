@page "/"
@namespace CandyDataEditor.Pages

<div class="container-fluid p-4">
    <!-- Welcome Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1">Candy Data Editor</h2>
            <p class="text-muted mb-0">Select a dataset from the sidebar to start editing, or pick up where you left off.</p>
        </div>
    </div>

    <!-- Quick Stats & Actions Grid -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">Spellcheck Status</h6>
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        <span class="small">Engine: <strong>JS / ProseMirror</strong></span>

                        @if (IsDictionaryLoaded)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i>Ready: @WordCount.ToString("N0") words active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-light">
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                Loading...
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">Shortcuts</h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-1"><code>Ctrl + S</code> — Save current record</li>
                        <li class="mb-1"><code>Right-Click Word</code> — Open Spellcheck suggestions</li>
                        <li><code>Ctrl + Alt + O</code> — Open VS Debug Console</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Databases -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent fw-bold py-3">
            <i class="bi bi-hdd-network me-2"></i>Recently Opened Databases
        </div>
        <div class="card-body p-0">
            @if (DbService.Config.RecentDatabases.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var dbPath in DbService.Config.RecentDatabases)
                    {
                        bool isCurrentDb = string.Equals(dbPath, DbService.GetDatabasePath(), StringComparison.OrdinalIgnoreCase);

                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 @(isCurrentDb ? "bg-light-subtle" : "")"
                                @onclick="() => OpenDatabaseAsync(dbPath)">
                            <div class="text-truncate me-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold text-primary text-truncate">
                                        <i class="bi bi-database me-2"></i>@System.IO.Path.GetFileName(dbPath)
                                    </span>

                                    @if (isCurrentDb)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-7">
                                            <i class="bi bi-check-circle-fill me-1"></i>Active
                                        </span>
                                    }
                                </div>
                                <small class="text-muted text-truncate d-block font-monospace fs-7 mt-1">
                                    @dbPath
                                </small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-database-gear fs-2 d-block mb-2"></i>
                    No recent databases found. Use <strong>File &rarr; Open</strong> from the ribbon menu to load a database.
                </div>
            }
        </div>
    </div>
</div>
