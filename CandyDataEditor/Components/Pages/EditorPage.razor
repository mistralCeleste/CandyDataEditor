@page "/editor"
@page "/editor/{TableName}"
@namespace CandyDataEditor.Pages
@using CandyDataEditor.Services

<PageTitle>SQLite Record Editor</PageTitle>

<div class="container-fluid my-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3>🗄️ <code>@TableName</code></h3>
    </div>

    <div class="row">
        <!-- Main Workspace Area -->
        <div class="col-md-auto">
            @if (editingRow == null)
            {
                <!-- TABLE GRID VIEW -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Table: @selectedTable</span>
                        <div class="d-flex align-items-center gap-2">
                            @if (tableData != null)
                            {
                                <small class="text-muted me-2">Total Rows: <strong>@tableData.Rows.Count</strong></small>
                            }
                            <button class="btn btn-sm btn-success" @onclick="CreateNewRecord">➕ New Record</button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (isLoadingData)
                        {
                            <div class="p-4 text-center text-muted">Loading data...</div>
                        }
                        else if (tableData != null && tableData.Columns.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-striped table-bordered mb-0 align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            @foreach (var col in tableData.Columns)
                                            {
                                                <th>@col</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in tableData.Rows)
                                        {
                                            <tr style="cursor: pointer;" @onclick="() => OpenRecordEditor(row)">
                                                @foreach (var col in tableData.Columns)
                                                {
                                                    <td class="text-truncate" style="max-width: 200px;" title="@row[col]">
                                                        @row[col]
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- VERTICAL RECORD EDITOR VIEW -->
                <div class="card shadow-sm mb-4" @key='@($"{selectedTable}_{FormatKeyMapLabel(originalKeys)}")'>
                    <!-- STICKY OPERATIONS HEADER BAR -->
                    <div class="card-header bg-primary text-white sticky-top shadow-sm py-2" style="z-index: 1020;">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold me-2">Record: @selectedTable</span>

                                <!-- Prev / Next Record Buttons -->
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-light" title="Previous Record" @onclick="NavigateToPreviousRecord" disabled="@(!HasPreviousRecord)">◀ Prev</button>
                                    <button class="btn btn-outline-light" title="Next Record" @onclick="NavigateToNextRecord" disabled="@(!HasNextRecord)">Next ▶</button>
                                </div>

                                <!-- Direct Primary Key Jump Selector -->
                                @if (tableRecordKeys.ContainsKey(selectedTable) && tableRecordKeys[selectedTable].Any())
                                {
                                    <select class="form-select form-select-sm w-auto" @onchange="OnPkJumpSelected">
                                        @foreach (var km in tableRecordKeys[selectedTable])
                                        {
                                            string l = FormatKeyMapLabel(km);
                                            bool isSel = IsMatchingKeys(km, originalKeys);
                                            <option value="@l" selected="@isSel">@l</option>
                                        }
                                    </select>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <!-- Auto-Save Toggle -->
                                <div class="form-check form-switch me-2 text-white">
                                    <input class="form-check-input" type="checkbox" id="autoSaveToggle" @bind="autoSaveEnabled" />
                                    <label class="form-check-label small fw-bold" for="autoSaveToggle">
                                        Auto-Save: @(autoSaveEnabled ? "ON" : "OFF")
                                    </label>
                                </div>

                                <button class="btn btn-sm btn-success" @onclick="SaveCurrentRecord">💾 Save</button>
                                <button class="btn btn-sm btn-info text-white" @onclick="CloneCurrentRecord">📋 Clone</button>
                                <button class="btn btn-sm btn-danger" @onclick="DeleteCurrentRecord">🗑️ Delete</button>
                                <button class="btn btn-sm btn-outline-light" @onclick="CloseRecordEditor">❌ Back</button>
                            </div>
                        </div>
                    </div>

                    <!-- Global Save Error Banner -->
                    @if (!string.IsNullOrEmpty(saveErrorMessage))
                    {
                        <div class="alert alert-danger m-3 mb-0" role="alert">
                            <strong>⚠️ Error:</strong> @saveErrorMessage
                        </div>
                    }

                    <!-- MAIN FIELDS LIST -->
                    <div class="card-body">
                        @if (tableData != null)
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var col in tableData.Columns)
                                {
                                    var meta = columnMetadata.TryGetValue(col, out var m) ? m : new ColumnMetadata();
                                    string fieldValue = GetFieldValue(col);
                                    int lineCount = DbService.Config.GetLineCountForText(fieldValue);
                                    string fieldHeightStyle = $"min-height: {lineCount * 1.6}rem;";

                                    <div @key="col" class="border rounded p-3 @(meta.IsReadOnly || meta.IsGenerated ? "bg-body-tertiary" : "bg-body")">
                                        <label class="form-label fw-bold d-flex justify-content-between align-items-center">
                                            <span>@col</span>
                                            <div>
                                                @if (meta.IsPrimaryKey)
                                                {
                                                    <span class="badge bg-primary me-1">Primary Key</span>
                                                }
                                                @if (meta.IsGenerated)
                                                {
                                                    <span class="badge bg-secondary me-1">Generated Field</span>
                                                }
                                                @if (meta.IsReadOnly && !meta.IsGenerated)
                                                {
                                                    <span class="badge bg-dark me-1">(Read-Only)</span>
                                                }
                                            </div>
                                        </label>

                                        @if (meta.IsGenerated || meta.IsReadOnly)
                                        {
                                            <input type="text" class="form-control" readonly value="@fieldValue" />
                                        }
                                        else
                                        {
                                            <div style="@fieldHeightStyle">
                                                <TipTapEditor MarkdownValue="@GetFieldValue(col)"
                                                              MarkdownValueChanged="(val) => SetFieldValue(col, val)"
                                                              OnBlur="OnFieldFocusLost" />
                                            </div>
                                        }

                                        @if (fieldErrorMessages.TryGetValue(col, out string? fieldError))
                                        {
                                            <div class="text-danger small mt-1 fw-bold">
                                                ❌ @fieldError
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- UNSAVED CHANGES WARNING MODAL -->
<UnsavedChangesModal @bind-IsOpen="showUnsavedModal"
                     OnDiscard="RevertAndProceed"
                     OnSave="SaveAndProceed" />
