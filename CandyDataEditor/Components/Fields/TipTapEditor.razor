@namespace CandyDataEditor.Components.Fields
@using CandyDataEditor.Components.Spellcheck

<div id="@elementId" class="tiptap-wrapper border rounded position-relative">
    <!-- Editor Toolbar -->
    <div class="tiptap-toolbar bg-light border-bottom p-2 d-flex gap-1 align-items-center flex-wrap position-relative">

        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("bold"))' title="Bold (Ctrl+B)">
            <b>B</b>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("italic"))' title="Italic (Ctrl+I)">
            <i>I</i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("keyword"))' title="Keyword (Ctrl+K)">
            <u><b>K</b></u>
        </button>

        <div class="vr mx-1"></div>

        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("heading1"))' title="Parent Action (#)">
            #
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("heading2"))' title="Child Action (##)">
            ##
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("actionParent"))' title="Parent Action (@@)">
            @@
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("actionChild"))' title="Child Action (@@@@)">
            @@@@
        </button> 
        <button type="button" class="btn btn-sm btn-outline-secondary game-icon-ligature" @onclick='() => ExecCommand("toggleList")' title="Toggle List (~)">
            [arrowhead]
        </button>

        <div class="vr mx-1"></div>

        <!-- Searchable Icon Picker Button -->
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenIconModal">
            🔍 Icons (@AllIcons.Count)
        </button>

        <div class="ms-auto d-flex gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("undo"))'>↶</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='(() => ExecCommand("redo"))'>↷</button>

            <div class="vr mx-1"></div>

            <div class="d-flex justify-content-between align-items-center bg-light">
                <div class="btn-group btn-group-sm" role="group" aria-label="Editor View Mode">
                    <button type="button"
                            class="btn btn-sm @(currentViewMode == ViewMode.Formatted ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SwitchViewMode(ViewMode.Formatted)">
                        📝
                    </button>
                    <button type="button"
                            class="btn btn-sm @(currentViewMode == ViewMode.Markdown ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SwitchViewMode(ViewMode.Markdown)">
                        🏷️
                    </button>
                    <button type="button"
                            class="btn btn-sm @(currentViewMode == ViewMode.Html ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SwitchViewMode(ViewMode.Html)">
                        🌐
                    </button>
                </div>

                <small class="text-muted">
                    &nbsp; Mode: <strong>@currentViewMode.ToString()</strong>
                </small>
            </div>
        </div>
    </div>

    <!-- FORMATTED VIEW (TipTap ProseMirror Canvas) -->
    <div class="@(currentViewMode == ViewMode.Formatted ? "d-block" : "d-none")">
        <div id="@EditorId" class="tiptap-container p-3"></div>
    </div>

    <!-- MARKDOWN VIEW (Editable Raw Markdown Area) -->
    @if (currentViewMode == ViewMode.Markdown)
    {
        <div class="p-2">
            <textarea class="form-control font-monospace text-monospace"
                      rows="12"
                      style="font-family: 'Consolas', 'Courier New', monospace; font-size: 0.9rem;"
                      value="@MarkdownValue"
                      @oninput="OnMarkdownRawInput"></textarea>
        </div>
    }

    <!-- HTML VIEW (Editable Raw HTML Area) -->
    @if (currentViewMode == ViewMode.Html)
    {
        <div class="p-2">
            <textarea class="form-control font-monospace text-monospace"
                      rows="12"
                      style="font-family: 'Consolas', 'Courier New', monospace; font-size: 0.9rem;"
                      value="@Value"
                      @oninput="OnHtmlRawInput"></textarea>
        </div>
    }

    <!-- Custom Right-Click Context Menu for Misspelled Words -->
    <SpellcheckContextMenu @bind-IsVisible="isContextMenuVisible"
                           X="@contextMenuX"
                           Y="@contextMenuY"
                           Word="@selectedMisspelledWord"
                           Suggestions="@suggestions"
                           OnReplaceWord="ReplaceWord"
                           OnAddToDictionary="AddSelectedWordToDictionary" />
</div>

<!-- Searchable GameIcons Modal -->
<GameIconPickerModal @bind-IsOpen="isIconModalOpen"
                     SearchTerm="@searchTerm"
                     OnIconSelected="SelectIcon" />
