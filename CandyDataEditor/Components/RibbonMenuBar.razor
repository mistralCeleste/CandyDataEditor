<!-- Components/RibbonMenuBar.razor -->
@using CandyDataEditor.Services
@using System.IO
@using System.Diagnostics
@inject SqliteDataService DbService
@inject FileDialogService FileDialog
@inject GameDictionaryService DictionaryService
@inject IJSRuntime JSRuntime

<div class="ribbon-bar border-bottom bg-light px-3 py-1 d-flex align-items-center justify-content-between shadow-sm position-relative">
    <div class="d-flex align-items-center gap-1">

        <!-- FILE MENU -->
        <div class="dropdown position-relative">
            <button class="btn btn-sm @(openMenu == "file" ? "btn-secondary" : "btn-outline-secondary") fw-bold"
                    type="button"
                    @onclick='() => ToggleMenu("file")'>
                📁 File
            </button>
            @if (openMenu == "file")
            {
                <div class="dropdown-menu show shadow position-absolute start-0 mt-1 py-1" style="z-index: 2000; min-width: 220px;">
                    <button class="dropdown-item" @onclick="OpenDatabaseFileDialog">📂 Open Database...</button>
                    <button class="dropdown-item" @onclick="SaveDatabaseAsDialog">💾 Save As...</button>
                    <button class="dropdown-item text-danger d-flex align-items-center @(!DbService.HasActiveDatabase ? "disabled" : "")"
                            @onclick="CloseCurrentDatabase"
                            disabled="@(!DbService.HasActiveDatabase)">
                        <i class="bi bi-x-circle me-2"></i>Close Database
                    </button>
                    <div class="dropdown-divider"></div>
                    <div class="dropdown-header text-uppercase small text-muted">Recent Databases</div>
                    @if (DbService.Config.RecentDatabases.Any())
                    {
                        @foreach (var dbPath in DbService.Config.RecentDatabases)
                        {
                            bool isCurrentDb = string.Equals(dbPath, DbService.CurrentDatabasePath, StringComparison.OrdinalIgnoreCase);

                            <button class="dropdown-item text-truncate d-flex align-items-center justify-content-between @(isCurrentDb ? "active fw-bold" : "")"
                                    style="max-width: 320px;"
                                    title="@dbPath"
                                    @onclick="() => LoadRecentDatabase(dbPath)">
                                <span>⏱️ @ShortenPath(dbPath)</span>
                                @if (isCurrentDb)
                                {
                                    <span class="badge bg-success ms-2">Active</span>
                                }
                            </button>
                        }
                    }
                    else
                    {
                        <span class="dropdown-item disabled text-muted">No recent files</span>
                    }
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item text-danger" @onclick="ExitApplication">❌ Exit</button>
                </div>
            }
        </div>

        <!-- SETTINGS MENU -->
        <div class="dropdown position-relative">
            <button class="btn btn-sm @(openMenu == "settings" ? "btn-secondary" : "btn-outline-secondary") fw-bold"
                    type="button"
                    @onclick='() => ToggleMenu("settings")'>
                ⚙️ Settings
            </button>
            @if (openMenu == "settings")
            {
                <div class="dropdown-menu show shadow position-absolute start-0 mt-1 py-1" style="z-index: 2000; min-width: 220px;">
                    <button class="dropdown-item" @onclick='() => OpenSettingsTab("ligature")'>🔤 Ligature Font Settings</button>
                    <button class="dropdown-item" @onclick='() => OpenSettingsTab("dictionary")'>📖 Spellcheck Dictionaries</button>
                    <button class="dropdown-item" @onclick='() => OpenSettingsTab("editor")'>🗄️ SQLite Editor Config</button>
                    <button class="dropdown-item" @onclick='() => OpenSettingsTab("ui")'>🎨 UI & Dark Mode</button>
                </div>
            }
        </div>

        <!-- EXPORT MENU -->
        <div class="dropdown position-relative">
            <button class="btn btn-sm @(openMenu == "export" ? "btn-secondary" : "btn-outline-secondary") fw-bold"
                    type="button"
                    @onclick='() => ToggleMenu("export")'>
                📤 Export
            </button>
            @if (openMenu == "export")
            {
                <div class="dropdown-menu show shadow position-absolute start-0 mt-1 py-1" style="z-index: 2000; min-width: 240px;">
                    <div class="px-3 py-1">
                        <label class="form-label mb-1 small fw-bold">Scope:</label>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn @(exportScope == "all" ? "btn-primary" : "btn-outline-primary")" @onclick='() => exportScope = "all"'>All</button>
                            <button type="button" class="btn @(exportScope == "table" ? "btn-primary" : "btn-outline-primary")" @onclick='() => exportScope = "table"'>Tables</button>
                            <button type="button" class="btn @(exportScope == "view" ? "btn-primary" : "btn-outline-primary")" @onclick='() => exportScope = "view"'>Views</button>
                        </div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item" @onclick='() => ExportData("tsv")'>📄 Tab-Delimited (.TSV)</button>
                    <button class="dropdown-item" @onclick='() => ExportData("csv")'>📊 Comma-Delimited (.CSV)</button>
                    <button class="dropdown-item" @onclick='() => ExportData("xml")'>🏷️ XML Document (.XML)</button>
                    <button class="dropdown-item" @onclick='() => ExportData("json")'>📦 JSON Data (.JSON)</button>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item fw-bold text-primary" @onclick='() => ExportData("html-cards")'>🌐 Interactive HTML Cards Bundle</button>
                </div>
            }
        </div>
    </div>

    <!-- Active DB Name Indicator -->
    <div class="small text-muted text-truncate ms-3" style="max-width: 350px;" title="@DbService.CurrentDatabasePath">
        <strong>Current DB:</strong> @(string.IsNullOrEmpty(DbService.CurrentDatabasePath) ? "None" : Path.GetFileName(DbService.CurrentDatabasePath))
    </div>
</div>

<!-- SETTINGS MODAL DIALOG -->
@if (!string.IsNullOrEmpty(activeSettingsTab))
{
    <div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1" style="z-index: 3000;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-primary text-white py-2">
                    <h5 class="modal-title fw-bold">⚙️ Configuration & Settings</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick='() => activeSettingsTab = null'></button>
                </div>
                <div class="modal-body">
                    <!-- Nav Tabs -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(activeSettingsTab == "ligature" ? "active fw-bold" : "")" @onclick='() => activeSettingsTab = "ligature"'>🔤 Font Ligatures</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeSettingsTab == "dictionary" ? "active fw-bold" : "")" @onclick='() => OpenSettingsTab("dictionary")'>📖 Dictionaries</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeSettingsTab == "editor" ? "active fw-bold" : "")" @onclick='() => activeSettingsTab = "editor"'>🗄️ SQLite Config</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeSettingsTab == "ui" ? "active fw-bold" : "")" @onclick='() => activeSettingsTab = "ui"'>🎨 UI & Appearance</button>
                        </li>
                    </ul>

                    <!-- Tab 1: Ligature Font Settings -->
                    @if (activeSettingsTab == "ligature")
                    {
                        <div class="p-2">
                            <h6>🔤 Game Icon & Ligature Settings</h6>
                            <p class="text-muted small">Configure font ligatures (e.g., <code>[place]</code> → 📍, <code>[defense]</code> → 🛡️) for TipTap editor previewing.</p>

                            <div class="mb-3">
                                <button class="btn btn-sm btn-outline-primary" @onclick="AutoDetectFontLigatures">
                                    🔍 Auto-Detect Font Icons & Ligatures
                                </button>
                            </div>

                            <div class="table-responsive" style="max-height: 250px;">
                                <table class="table table-sm table-bordered mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ligature Pattern</th>
                                            <th>Icon Render Preview</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><code>[place]</code></td><td>📍 Location Marker</td></tr>
                                        <tr><td><code>[defense]</code></td><td>🛡️ Defense Shield</td></tr>
                                        <tr><td><code>[warning]</code></td><td>⚠️ Warning Reaction</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- Tab 2: SQLite Config Settings -->
                    @if (activeSettingsTab == "editor")
                    {
                        <div class="p-2">
                            <h6>🗄️ Database Query & Field Thresholds</h6>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Query Row Limit</label>
                                    <input type="number" class="form-control form-control-sm" @bind="DbService.Config.QueryRowLimit" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Small Field Threshold (Chars)</label>
                                    <input type="number" class="form-control form-control-sm" @bind="DbService.Config.SmallCharThreshold" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Medium Field Threshold (Chars)</label>
                                    <input type="number" class="form-control form-control-sm" @bind="DbService.Config.MediumCharThreshold" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Large Field Threshold (Chars)</label>
                                    <input type="number" class="form-control form-control-sm" @bind="DbService.Config.LargeCharThreshold" />
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Tab 3: UI & Appearance Settings -->
                    @if (activeSettingsTab == "ui")
                    {
                        <div class="p-2">
                            <h6>🎨 Theme & Appearance</h6>
                            <div class="mb-3 mt-2">
                                <label class="form-label small fw-bold">Theme Mode</label>
                                <div class="btn-group w-100">
                                    <button class="btn btn-outline-light @(!isDarkMode ? "active" : "")" @onclick="() => ToggleTheme(false)">☀️ Light Mode</button>
                                    <button class="btn btn-outline-dark @(isDarkMode ? "active" : "")" @onclick="() => ToggleTheme(true)">🌙 Dark Mode</button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Tab 4: Dictionary & Spellcheck Settings -->
                    @if (activeSettingsTab == "dictionary")
                    {
                        <div class="p-2">
                            <!-- HEADER & DIRECTORY ACTION -->
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                                <div class="overflow-hidden">
                                    <h6 class="mb-1">📖 Loaded Dictionaries & Vocabulary</h6>
                                    <div class="text-muted small text-break p-2 bg-body-tertiary font-monospace">
                                        <strong>Directory:</strong> <code>@dictDirectoryPath</code>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-outline-primary align-self-start align-self-sm-center flex-shrink-0"
                                        @onclick="OpenDictionaryDirectoryInExplorer">
                                    📂 Open Folder in Explorer
                                </button>
                            </div>

                            <!-- LOADED DICTIONARY FILES LIST -->
                            <div class="card mb-3 shadow-sm">
                                <div class="card-header bg-body-tertiary fw-bold py-1 fs-7">Active Dictionary Files</div>
                                <div class="card-body p-0">
                                    <div class="table-responsive" style="max-height: 140px;">
                                        <table class="table table-sm table-striped table-hover mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Filename</th>
                                                    <th>Word Count</th>
                                                    <th>Path</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (loadedDictFiles.Any())
                                                {
                                                    @foreach (var file in loadedDictFiles)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">📄 @file.FileName</td>
                                                            <td><span class="badge bg-secondary">@file.WordCount.ToString("N0") words</span></td>
                                                            <td class="text-muted small text-truncate" style="max-width: 250px;" title="@file.FullPath">@file.FullPath</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr><td colspan="3" class="text-muted text-center py-2">No dictionary files found in directory.</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- WORD MANAGEMENT & SEARCH -->
                            <div class="card shadow-sm">
                                <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center py-1 fs-7">
                                    <span class="fw-bold">Manage Words (@activeDictionaryWords.Count Total)</span>
                                    <div class="d-flex gap-2">
                                        <input type="text" class="form-control form-control-sm" placeholder="🔍 Search dictionary..."
                                               @bind="dictSearchQuery" @bind:event="oninput" style="width: 180px;" />
                                    </div>
                                </div>
                                <div class="card-body">
                                    <!-- ADD WORD FORM -->
                                    <div class="input-group input-group-sm mb-3">
                                        <input type="text" class="form-control" placeholder="Enter new custom word..." @bind="newWordInput" @onkeyup="HandleNewWordKeyUp" />
                                        <button class="btn btn-success" type="button" @onclick="AddNewWord">➕ Add Word</button>
                                    </div>

                                    <!-- FILTERED WORDS TABLE -->
                                    <div class="table-responsive" style="max-height: 220px;">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light sticky-top">
                                                <tr>
                                                    <th>Word</th>
                                                    <th class="text-end">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (FilteredDictionaryWords.Any())
                                                {
                                                    @foreach (var word in FilteredDictionaryWords.Take(100))
                                                    {
                                                        <tr>
                                                            <td><code>@word</code></td>
                                                            <td class="text-end">
                                                                <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Remove Word" @onclick="() => RemoveWord(word)">
                                                                    🗑️
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="2" class="text-center text-muted py-3">No matching words found.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (FilteredDictionaryWords.Count() > 100)
                                    {
                                        <div class="text-muted fs-8 mt-1 text-end">Showing first 100 results...</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-secondary" @onclick='() => activeSettingsTab = null'>Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string? openMenu = null;
    private string? activeSettingsTab = null;
    private string exportScope = "all";
    private bool isDarkMode = false;

    protected override async Task OnInitializedAsync()
    {
        isDarkMode = DbService.Config.IsDarkMode;
        await ToggleTheme(isDarkMode);
    }

    private async Task ToggleTheme(bool dark)
    {
        isDarkMode = dark;
        DbService.Config.IsDarkMode = dark;
        await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-bs-theme", dark ? "dark" : "light");
    }

    private void ToggleMenu(string menuName)
    {
        openMenu = openMenu == menuName ? null : menuName;
    }

    private void CloseMenus()
    {
        openMenu = null;
    }

    private string ShortenPath(string path)
    {
        if (string.IsNullOrEmpty(path) || path.Length <= 35) return path;
        string root = Path.GetPathRoot(path) ?? "";
        string fileName = Path.GetFileName(path);
        return $"{root}...\\{fileName}";
    }

    private async Task OpenDatabaseFileDialog()
    {
        CloseMenus();

        string? selectedFilePath = await FileDialog.SelectDatabaseFileDialogAsync();

        if (!string.IsNullOrWhiteSpace(selectedFilePath) && File.Exists(selectedFilePath))
        {
            // Triggers OnDatabasePathChanged -> Home & MainLayout reflect immediately
            await DbService.SetDatabasePathAsync(selectedFilePath);
        }
    }

    private async Task SaveDatabaseAsDialog()
    {
        CloseMenus();

        string currentDbPath = DbService.CurrentDatabasePath;
        string defaultName = $"game_data_copy_{DateTime.Now:yyyyMMdd_HHmmss}.db";

        string? savedPath = await FileDialog.SelectFileDialogAsync(defaultName, currentDbPath);

        if (!string.IsNullOrWhiteSpace(savedPath))
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Database copy saved successfully to:\n{savedPath}");
        }
    }

    private async Task CloseCurrentDatabase()
    {
        CloseMenus();
        await DbService.CloseDatabaseAsync();
    }

    private async Task LoadRecentDatabase(string path)
    {
        CloseMenus();

        if (File.Exists(path))
        {
            // Triggers OnDatabasePathChanged -> Home & MainLayout reflect immediately
            await DbService.SetDatabasePathAsync(path);
        }
        else
        {
            DbService.Config.RemoveRecentDatabase(path);
        }
    }

    private void ExitApplication()
    {
        CloseMenus();
        Application.Current?.Quit();
    }

    private async Task AutoDetectFontLigatures()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Font ligatures scanned and updated!");
    }

    private async Task ExportData(string format)
    {
        CloseMenus();

        string? exportFolder = await FileDialog.SelectExportFolderDialogAsync();
        if (string.IsNullOrEmpty(exportFolder)) return;

        var tables = await DbService.GetTablesAndViewsAsync();
        var filtered = tables
            .Where(t => exportScope == "all" || t.Type == exportScope)
            .Select(t => t.Name)
            .ToList();

        if (format == "html-cards")
        {
            await DbService.ExportHtmlCardsBundleAsync(filtered, exportFolder);
            await JSRuntime.InvokeVoidAsync("alert", $"HTML Cards Bundle exported to:\n{exportFolder}");
        }
        else
        {
            await DbService.ExportDataFilesAsync(filtered, format, exportFolder);
            await JSRuntime.InvokeVoidAsync("alert", $"Exported {filtered.Count} object(s) in {format.ToUpper()} format to:\n{exportFolder}");
        }
    }

    // Dictionary State Fields
    private string dictDirectoryPath = string.Empty;
    private List<DictionaryFileInfo> loadedDictFiles = new();
    private List<string> activeDictionaryWords = new();
    private string dictSearchQuery = string.Empty;
    private string newWordInput = string.Empty;

    public class DictionaryFileInfo
    {
        public string FileName { get; set; } = string.Empty;
        public string FullPath { get; set; } = string.Empty;
        public int WordCount { get; set; }
    }

    private IEnumerable<string> FilteredDictionaryWords =>
        string.IsNullOrWhiteSpace(dictSearchQuery)
            ? activeDictionaryWords
            : activeDictionaryWords.Where(w => w.Contains(dictSearchQuery, StringComparison.OrdinalIgnoreCase));

    private async Task RefreshDictionaryState()
    {
        // Point to the active, writeable AppData dictionaries folder
        dictDirectoryPath = DictionaryService.GetLocalDictionariesFolder();
        activeDictionaryWords = await DictionaryService.SyncAndLoadAllDictionariesAsync();

        loadedDictFiles.Clear();
        if (Directory.Exists(dictDirectoryPath))
        {
            var files = Directory.GetFiles(dictDirectoryPath, "*.txt");
            foreach (var file in files)
            {
                var lines = await File.ReadAllLinesAsync(file);
                loadedDictFiles.Add(new DictionaryFileInfo
                {
                    FileName = Path.GetFileName(file),
                    FullPath = file,
                    WordCount = lines.Length
                });
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("setGlobalGameDictionary", activeDictionaryWords);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"JS Dict Sync Error: {ex.Message}");
        }
    }

    private async Task OpenSettingsTab(string tabName)
    {
        activeSettingsTab = tabName;
        CloseMenus();

        if (tabName == "dictionary")
        {
            await RefreshDictionaryState();
        }
    }

    private void OpenDictionaryDirectoryInExplorer()
    {
        if (Directory.Exists(dictDirectoryPath))
        {
            Process.Start(new ProcessStartInfo
            {
                FileName = dictDirectoryPath,
                UseShellExecute = true,
                Verb = "open"
            });
        }
    }

    private async Task HandleNewWordKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddNewWord();
        }
    }

    private async Task AddNewWord()
    {
        if (string.IsNullOrWhiteSpace(newWordInput)) return;

        string word = newWordInput.Trim();
        if (!activeDictionaryWords.Contains(word, StringComparer.OrdinalIgnoreCase))
        {
            await DictionaryService.AddWordToDictionaryFileAsync("custom_user_words.txt", word);
            newWordInput = string.Empty;
            await RefreshDictionaryState();
        }
    }

    private async Task RemoveWord(string word)
    {
        if (string.IsNullOrWhiteSpace(word)) return;

        // Removes from ALL .txt files in AppData (including english_base.txt)
        await DictionaryService.RemoveWordFromAllDictionariesAsync(word);
        await RefreshDictionaryState();
    }
}
