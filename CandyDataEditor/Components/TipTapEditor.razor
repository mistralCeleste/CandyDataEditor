    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyTipTap", EditorId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error disposing TipTap editor JS interop: {ex}");
        }

        _dotnetRef?.Dispose();
    }
}
