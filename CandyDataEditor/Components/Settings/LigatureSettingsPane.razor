@* Components/LigatureSettingsTab.razor *@
@namespace CandyDataEditor.Components.Settings

<div class="p-2">
    <h6>🔤 Game Icon & Ligature Settings</h6>
    <p class="text-muted small">
        Configure font ligatures (e.g., <code>[place]</code> → <span class="game-icon-ligature">[place]</span>, <code>[defense]</code> → <span class="game-icon-ligature">[defense]</span>) for TipTap editor previewing.
    </p>

    <!-- Font File Selection & Scan Action -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <label class="form-label fw-bold small mb-1">Target Font File Path (.ttf / .otf)</label>
            <div class="input-group input-group-sm">
                <input type="text" class="form-control" placeholder="C:\Path\To\GameIcons.ttf" @bind="fontFilePath" />
                <button class="btn btn-outline-primary" @onclick="AutoDetectFontLigaturesAsync" disabled="@isScanning">
                    @if (isScanning)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Scanning Font...</span>
                    }
                    else
                    {
                        <span>🔍 Scan Font Ligatures</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="text-danger small mt-1 fw-bold">⚠️ @errorMessage</div>
            }
        </div>
    </div>

    <!-- Scan Results Summary & Badge Grid -->
    @if (hasScanned)
    {
        <div class="card shadow-sm mb-3 border-success-subtle">
            <div class="card-header bg-success-subtle text-success-emphasis fw-bold py-1 fs-7 d-flex justify-content-between align-items-center">
                <span>Scan Results</span>
                <span class="badge bg-success">@detectedLigatures.Count ligatures detected</span>
            </div>
            <div class="card-body py-2">
                @if (detectedLigatures.Any())
                {
                    <div class="d-flex flex-wrap gap-2 overflow-auto" style="max-height: 180px;">
                        @foreach (var ligature in detectedLigatures)
                        {
                            <span class="badge bg-body-tertiary text-body border p-2 d-inline-flex align-items-center gap-2 cursor-pointer"
                                  title="Click to copy @ligature"
                                  @onclick="() => SelectLigature(ligature)">
                                <span class="game-icon-ligature fs-5">[@ligature]</span>
                                <code class="small text-muted">[@ligature]</code>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small text-center py-2">
                        No bracketed ligatures (e.g., <code>[icon_name]</code>) were found in the scanned font file.
                    </div>
                }
            </div>
        </div>
    }

    <!-- Available Icons Reference Pane -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-body-tertiary fw-bold py-1 fs-7">Available Game Icons & Ligatures</div>
        <div class="card-body p-2">
            <GameIconPickerPane MaxHeight="250px" OnIconSelected="OnIconSelectedFromPane" />
        </div>
    </div>
</div>
