@* Components/Panes/LigatureSettingsPane.razor *@
@namespace CandyDataEditor.Components.Settings
@using CandyDataEditor.Components.Fonts

<div class="p-3 h-100 overflow-auto">
    <div class="d-flex align-items-center mb-3">
        <h6 class="mb-0 fw-bold text-primary">🔤 Game Icon & Font Ligature Settings</h6>
    </div>

    <p class="text-muted small">
        Configure the font file and OpenType feature table used to detect custom ligatures.
    </p>

    <!-- Configuration Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-body-tertiary fw-bold py-2 fs-7">
            Font Source Configuration
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold small mb-1">Font File Path (.ttf / .otf)</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" placeholder="C:\Path\To\GameIcons.ttf"
                           @bind="Config.FontFilePath" @bind:after="SaveConfigState" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="BrowseFontFileAsync">
                        📁 Browse
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small mb-1">GSUB Feature Table Name</label>
                <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                       placeholder="liga" @bind="Config.FontFeatureTable" @bind:after="SaveConfigState" />
            </div>

            <div class="d-flex align-items-center gap-2 mt-4 pt-2 border-top">
                <button class="btn btn-primary btn-sm" @onclick="ScanFontLigaturesAsync" disabled="@isScanning">
                    @if (isScanning)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Scanning Font...</span>
                    }
                    else
                    {
                        <span>🔍 Scan & Parse Ligatures</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="text-danger small mt-2 fw-bold">⚠️ @errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="text-success small mt-2 fw-bold">✅ @statusMessage</div>
            }
        </div>
    </div>

    <!-- Active Icon Preview & Search via Reusable Picker -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-body-tertiary fw-bold py-2 fs-7">
            Active Font Ligatures Preview
        </div>
        <div class="card-body p-3">
            <GameIconPickerPane MaxHeight="320px" OnIconSelected="OnIconSelectedFromSettings" />
        </div>
    </div>
</div>
