@namespace CandyDataEditor.Components.Layout
@using CandyDataEditor.Services

<aside class="sidebar-panel border-end bg-body-tertiary d-flex flex-column transition-all"
       style="width: @(isCollapsed ? "50px" : "320px"); min-width: @(isCollapsed ? "50px" : "280px"); max-width: @(isCollapsed ? "50px" : "400px"); transition: width 0.2s ease-in-out, min-width 0.2s ease-in-out;">

    @if (isCollapsed)
    {
        <!-- COLLAPSED STRIP VIEW -->
        <div class="p-2 d-flex flex-column align-items-center gap-3">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary py-1 px-2"
                    title="Expand Sidebar"
                    @onclick="ToggleCollapse">
                ⏩
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary py-1 px-2"
                    title="Refresh Objects"
                    @onclick="RefreshDatabaseObjectsAsync"
                    disabled="@(!DbService.HasActiveDatabase)">
                🔄
            </button>
        </div>
    }
    else
    {
        <!-- EXPANDED SIDEBAR VIEW -->
        <!-- Filter Header -->
        <div class="p-2 border-bottom bg-light d-flex flex-column gap-2">
            <div class="d-flex align-items-center justify-content-between">
                <span class="fw-bold small text-truncate">Database Explorer</span>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                            title="Refresh Objects"
                            @onclick="RefreshDatabaseObjectsAsync"
                            disabled="@(!DbService.HasActiveDatabase)">
                        🔄
                    </button>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1"
                            title="Close Database"
                            @onclick="CloseCurrentDatabaseAsync"
                            disabled="@(!DbService.HasActiveDatabase)">
                        ❌
                    </button>
                    <!-- Toggle Collapse Button -->
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1 ms-3"
                            title="Collapse Sidebar"
                            @onclick="ToggleCollapse">
                        ⏪
                    </button>
                </div>
            </div>

            <!-- Search/Filter Input with Debounce -->
            <div class="position-relative">
                <input type="text" class="form-control form-control-sm pe-4"
                       placeholder="🔍 Search tables or record content..."
                       value="@searchFilter" @oninput="OnSearchInputChanged" />
                @if (isSearchingData)
                {
                    <span class="spinner-border spinner-border-sm position-absolute end-0 top-50 translate-middle-y me-2 text-muted" role="status"></span>
                }
            </div>

            <!-- Scope Buttons -->
            <div class="btn-group btn-group-sm w-100" role="group">
                <button type="button" class="btn @(typeFilter == "all" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetTypeFilter("all")'>All</button>
                <button type="button" class="btn @(typeFilter == "table" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetTypeFilter("table")'>Tables</button>
                <button type="button" class="btn @(typeFilter == "view" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetTypeFilter("view")'>Views</button>
            </div>
        </div>

        <!-- Scrollable Objects & Search Results -->
        <div class="list-group list-group-flush overflow-auto flex-grow-1">
            @if (isLoadingTables)
            {
                <div class="p-3 text-muted text-center small">Loading objects...</div>
            }
            else
            {
                <!-- GROUP 1: TABLES & VIEWS -->
                <div class="bg-body-secondary px-2 py-1 border-bottom small fw-bold text-muted d-flex justify-content-between align-items-center cursor-pointer"
                     style="cursor: pointer;"
                     @onclick="ToggleTablesSection">
                    <span>@(isTablesSectionExpanded ? "▼" : "▶") TABLES & VIEWS (@FilteredObjects.Count())</span>
                </div>

                <!-- Render Group 1 Content -->
                @if (isTablesSectionExpanded)
                {
                    @foreach (var obj in FilteredObjects)
                    {
                        bool isExpanded = expandedTable == obj.Name;
                        bool isSelected = selectedTable == obj.Name;

                        <div class="list-group-item p-0 border-bottom">
                            <!-- Accordion Table Header -->
                            <div class="d-flex justify-content-between align-items-center p-2 cursor-pointer @(isSelected ? "bg-primary text-white fw-bold" : "bg-body-secondary")">
                                <span class="text-truncate" style="max-width: 170px;" title="@obj.Name"
                                      @onclick="() => ToggleTableAccordionAsync(obj.Name)">
                                    @(obj.Type == "view" ? "👁️" : "📄") @obj.Name
                                </span>

                                <div class="d-flex align-items-center gap-1">
                                    <!-- Grid View Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-dark py-0 px-1 border-0"
                                            title="Open Batch Table View"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => NavigateToTableGrid(obj.Name)">
                                        📊
                                    </button>

                                    <span class="badge @(obj.Type == "view" ? "bg-info text-dark" : "bg-secondary")"
                                          @onclick="() => ToggleTableAccordionAsync(obj.Name)">
                                        @(isExpanded ? "▲" : "▼")
                                    </span>
                                </div>
                            </div>

                            <!-- Accordion Primary Key Sub-List -->
                            @if (isExpanded)
                            {
                                <div class="bg-body border-top">
                                    @if (tableRecordKeys.ContainsKey(obj.Name) && tableRecordKeys[obj.Name].Any())
                                    {
                                        @foreach (var keyMap in tableRecordKeys[obj.Name])
                                        {
                                            string label = string.Join(" | ", keyMap.Values);

                                            <button type="button"
                                                    class="list-group-item list-group-item-action border-0 ps-4 py-1 small text-truncate"
                                                    @onclick="() => NavigateToRecord(obj.Name, keyMap)">
                                                🔑 @label
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="ps-4 py-2 small text-muted">No records found.</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }

                <!-- GROUP 2: SEARCH RESULTS (DATA MATCHES) -->
                @if (!string.IsNullOrWhiteSpace(searchFilter))
                {
                    <div class="bg-body-secondary px-2 py-1 border-bottom border-top small fw-bold text-muted mt-2 d-flex justify-content-between align-items-center cursor-pointer"
                         style="cursor: pointer;"
                         @onclick="ToggleSearchResultsSection">
                        <span>@(isSearchResultsExpanded ? "▼" : "▶") SEARCH RESULTS (@searchResults.Count)</span>
                        <div class="d-flex align-items-center gap-1">
                            @if (isSearchingData)
                            {
                                <span class="badge bg-secondary">Searching...</span>
                            }
                        </div>
                    </div>

                    <!-- Render Group 2 Content -->
                    @if (isSearchResultsExpanded)
                    {
                        @if (searchResults.Any())
                        {
                            var groupedResults = searchResults.GroupBy(r => r.TableName);

                            @foreach (var group in groupedResults)
                            {
                                <div class="border-bottom bg-body-tertiary p-1">
                                    <div class="small fw-bold px-2 py-1 text-primary">
                                        📋 @group.Key (@group.Count() matches)
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var match in group)
                                        {
                                            string pkLabel = string.Join(" | ", match.PrimaryKeys.Values);

                                            <div class="card card-body p-2 border-0 bg-body shadow-none rounded cursor-pointer search-snippet-card"
                                                 style="cursor: pointer;"
                                                 @onclick="() => NavigateToSearchMatch(match)">
                                                <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                                    <span class="fw-bold text-truncate" style="max-width: 150px;">🔑 @pkLabel</span>
                                                    <span class="badge bg-light text-dark border">@match.MatchingColumn</span>
                                                </div>
                                                <!-- Highlighted Context Snippet -->
                                                <div class="small text-secondary text-truncate font-monospace" style="font-size: 0.8rem;">
                                                    @match.SnippetPrefix<mark class="bg-warning text-dark fw-bold px-1 rounded">@match.MatchTerm</mark>@match.SnippetSuffix
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (!isSearchingData)
                        {
                            <div class="p-3 text-muted text-center small">
                                No record content matched "@searchFilter"
                            </div>
                        }
                    }
                }
            }
        </div>
    }
</aside>
