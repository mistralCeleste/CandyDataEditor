@inherits LayoutComponentBase
@using CandyDataEditor.Services
@inject SqliteDataService DbService

<div class="app-shell d-flex flex-column vh-100 overflow-hidden">

    <!-- TOP PINNED RIBBON BAR -->
    <RibbonMenuBar OnDatabaseChanged="HandleDatabaseChanged" />

    <!-- MAIN TWO-COLUMN CONTAINER -->
    <div class="d-flex flex-grow-1 overflow-hidden">

        <!-- LEFT SIDEBAR: Table / View Selector with Filter, Accordion & PKs -->
        <aside class="sidebar-panel border-end bg-body-tertiary d-flex flex-column" style="width: 320px; min-width: 280px; max-width: 400px;">

            <!-- Filter Header -->
            <div class="p-2 border-bottom bg-light d-flex flex-column gap-2">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-bold small">Database Objects (@FilteredObjects.Count())</span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Refresh Objects" @onclick="RefreshDatabaseObjects">🔄</button>
                </div>

                <!-- Filter Input -->
                <input type="text" class="form-control form-control-sm"
                       placeholder="🔍 Filter tables/views..."
                       @bind="searchFilter" @bind:event="oninput" />

                <!-- Scope Buttons -->
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button type="button" class="btn @(typeFilter == "all" ? "btn-primary" : "btn-outline-primary")" @onclick='() => typeFilter = "all"'>All</button>
                    <button type="button" class="btn @(typeFilter == "table" ? "btn-primary" : "btn-outline-primary")" @onclick='() => typeFilter = "table"'>Tables</button>
                    <button type="button" class="btn @(typeFilter == "view" ? "btn-primary" : "btn-outline-primary")" @onclick='() => typeFilter = "view"'>Views</button>
                </div>
            </div>

            <!-- Scrollable Object List & Accordions -->
            <div class="list-group list-group-flush overflow-auto flex-grow-1">
                @if (isLoadingTables)
                {
                    <div class="p-3 text-muted text-center small">Loading objects...</div>
                }
                else
                {
                    @foreach (var obj in FilteredObjects)
                    {
                        bool isExpanded = expandedTable == obj.Name;
                        bool isSelected = selectedTable == obj.Name;

                        <div class="list-group-item p-0 border-bottom">
                            <!-- Accordion Table Header -->
                            <div class="d-flex justify-content-between align-items-center p-2 cursor-pointer @(isSelected ? "bg-primary text-white fw-bold" : "bg-body-secondary")"
                                 @onclick="() => ToggleTableAccordion(obj.Name)">
                                <span class="text-truncate" style="max-width: 200px;" title="@obj.Name">
                                    @(obj.Type == "view" ? "👁️" : "📄") @obj.Name
                                </span>
                                <span class="badge @(obj.Type == "view" ? "bg-info text-dark" : "bg-secondary")">
                                    @(isExpanded ? "▲" : "▼")
                                </span>
                            </div>

                            <!-- Accordion Primary Key Sub-List -->
                            @if (isExpanded)
                            {
                                <div class="bg-body border-top">
                                    @if (tableRecordKeys.ContainsKey(obj.Name) && tableRecordKeys[obj.Name].Any())
                                    {
                                        @foreach (var keyMap in tableRecordKeys[obj.Name])
                                        {
                                            string label = string.Join(" | ", keyMap.Values);

                                            <button type="button"
                                                    class="list-group-item list-group-item-action border-0 ps-4 py-1 small text-truncate"
                                                    @onclick="() => NavigateToRecord(obj.Name, keyMap)">
                                                🔑 @label
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="ps-4 py-2 small text-muted">No records found.</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </aside>

        <!-- RIGHT WORKSPACE AREA (@Body) -->
        <main class="main-workspace flex-grow-1 overflow-auto p-3 bg-body">
            @Body
        </main>
    </div>
</div>

@code {
    private List<DbObjectInfo> dbObjects = new();
    private Dictionary<string, List<Dictionary<string, string>>> tableRecordKeys = new(StringComparer.OrdinalIgnoreCase);

    private string? selectedTable = null;
    private string? expandedTable = null;
    private bool isLoadingTables = true;

    private string searchFilter = string.Empty;
    private string typeFilter = "all";

    [Inject] private NavigationManager NavManager { get; set; } = default!;

    private IEnumerable<DbObjectInfo> FilteredObjects => dbObjects
        .Where(o => typeFilter == "all" || o.Type == typeFilter)
        .Where(o => string.IsNullOrWhiteSpace(searchFilter) || o.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await RefreshDatabaseObjects();
    }

    private async Task RefreshDatabaseObjects()
    {
        isLoadingTables = true;
        StateHasChanged();

        dbObjects = await DbService.GetTablesAndViewsAsync();
        tableRecordKeys.Clear();

        var firstTable = dbObjects.FirstOrDefault(o => o.Type == "table") ?? dbObjects.FirstOrDefault();
        if (firstTable != null)
        {
            selectedTable = firstTable.Name;
            expandedTable = firstTable.Name;
            await LoadRecordKeys(firstTable.Name);
        }

        isLoadingTables = false;
        StateHasChanged();
    }

    private async Task ToggleTableAccordion(string tableName)
    {
        if (expandedTable == tableName)
        {
            expandedTable = null;
        }
        else
        {
            expandedTable = tableName;
            selectedTable = tableName;
            await LoadRecordKeys(tableName);
        }
    }

    private async Task LoadRecordKeys(string tableName)
    {
        if (!tableRecordKeys.ContainsKey(tableName))
        {
            var meta = await DbService.GetColumnMetadataAsync(tableName);
            var pkCols = meta.Where(c => c.Value.IsPrimaryKey).Select(c => c.Key).ToList();

            if (!pkCols.Any())
            {
                var tableData = await DbService.GetTableDataAsync(tableName);
                if (tableData.Columns.Any()) pkCols.Add(tableData.Columns.First());
            }

            tableRecordKeys[tableName] = await DbService.GetRecordKeysAsync(tableName, pkCols);
        }
    }

    private void NavigateToRecord(string tableName, Dictionary<string, string> keyMap)
    {
        selectedTable = tableName;

        // Pass selection to the workspace via query parameters or page route
        string keyParams = string.Join("&", keyMap.Select(kvp => $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value)}"));
        NavManager.NavigateTo($"/editor/{Uri.EscapeDataString(tableName)}?{keyParams}");
    }

    private async Task HandleDatabaseChanged(string newPath)
    {
        expandedTable = null;
        selectedTable = null;
        await RefreshDatabaseObjects();
        NavManager.NavigateTo("/editor");
    }
}

