<!-- Layout/MainLayout.razor -->
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column flex-grow-1">
        <!-- GLOBAL RIBBON MENU BAR AT TOP OF APP -->
        <RibbonMenuBar OnDatabaseChanged="HandleDatabaseChanged" />

        <article class="content px-4 flex-grow-1">
            @Body
        </article>
    </main>
</div>

@code {
    private void HandleDatabaseChanged(string newPath)
    {
        // Triggers UI refresh across components when database path changes
        StateHasChanged();
    }


}
